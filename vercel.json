{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "regions": [
    "pdx1"
  ],
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "wsgi.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,work/**,browser_profiles/**,data/**,media/**,reports/**,outputs/**,_patch/**,*.md}"
    }
  }
}
